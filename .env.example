# ─── Telegram ────────────────────────────────────────────────────────────
BOT_TOKEN=123456:AA...
ADMINS=123456789

# ─── Maʼlumotlar bazasi ──────────────────────────────────────────────────
# Variant 1: tayyor DSN (ustuvor)
# DATABASE_URL=mysql+aiomysql://yozuv:parol@127.0.0.1:3306/yozuvbot?charset=utf8mb4

# Variant 2: alohida ösgaruvçilar — DSN avtomatik yiğiladi
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=yozuv
MYSQL_PASSWORD=parol
MYSQL_DB=yozuvbot
MYSQL_CHARSET=utf8mb4

# Ikkalasi ham bölmasa — SQLite faylidan foydalaniladi
DB_PATH=data/bot.sqlite3

DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20
SQL_ECHO=false

# ─── Tarqatma ────────────────────────────────────────────────────────────
# Sekundiga neçta xabar (Telegram çegarasi ~30)
BROADCAST_RATE=20

# ─── Boşqa ───────────────────────────────────────────────────────────────
CHANNEL_AUTO=false
THROTTLE=0.5
MAX_FILE_MB=20
LOG_LEVEL=INFO
